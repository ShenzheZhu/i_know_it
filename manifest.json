{
  "manifest_version": 3,
  "name": "I Know It!",
  "version": "0.5.1",
  "minimum_chrome_version": "120",
  "description": "Add source context to ordinary screenshots through a local background companion.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "I Know It!",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "context.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
